# Copy to .env and fill in real values. Never commit .env.
# Server port (default 5001)
PORT=5001
# Brevo SMTP credentials for outgoing email
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-brevo-smtp-key-here
# Password for the seeded admin account (created on first start).
# If unset or empty, NO admin account is created.
ADMIN_PASSWORD=choose-a-strong-password-here
